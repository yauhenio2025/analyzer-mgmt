# Copy to frontend/.env.local for local development.
# NEXT_PUBLIC_* values are inlined at BUILD time — after changing them on Render, redeploy.

# "The Analyst" service (fork of analyzer-v2, same route families). Every definitions /
# plans / runs / events / presenter call goes here. Slug may carry a suffix on Render.
NEXT_PUBLIC_ANALYZER_V2_URL=https://the-analyst-kcuc.onrender.com

# Legacy analyzer-mgmt-api (paradigms, pipelines, grids, rhetoric, consumers, changes).
# Leave unset locally to use the next.config.js rewrite to http://localhost:8002/api.
# NEXT_PUBLIC_API_URL=https://analyzer-mgmt-api.onrender.com/api

# Server-side rewrite target for /api/* when NEXT_PUBLIC_API_URL is unset (dev only).
# API_URL=http://localhost:8002/api
